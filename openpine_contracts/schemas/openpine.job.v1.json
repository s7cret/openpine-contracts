{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.job.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "job_id",
    "kind",
    "state",
    "version"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.job.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "QUEUED",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELED",
        "RETRY_WAIT",
        "LOST"
      ]
    },
    "progress": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "started_at_utc_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "updated_at_utc_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "finished_at_utc_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "input_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "result_artifact_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_deadline_utc_ms": {
      "type": [
        "integer",
        "null"
      ]
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0
    },
    "max_retries": {
      "type": [
        "integer",
        "null"
      ]
    },
    "parent_job_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "child_job_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_cursor": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
