{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.checkpoint.proof.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "checkpoint_id",
    "checkpoint_hash",
    "committed_sequence",
    "committed_message_id",
    "state_hash",
    "broker_projection_hash",
    "payload_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.checkpoint.proof.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer": {
      "const": "openpine"
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "stack_id": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "committed_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "committed_message_id": {
      "type": "string",
      "minLength": 1
    },
    "state_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "broker_projection_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "payload_ref": {
      "$ref": "#/$defs/CheckpointPayloadRef"
    }
  },
  "$defs": {
    "CheckpointPayloadRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "codec",
        "compression",
        "size_bytes",
        "segment_schema_hashes"
      ],
      "properties": {
        "codec": {
          "enum": [
            "json",
            "msgpack",
            "openpine.checkpoint.v1"
          ]
        },
        "compression": {
          "enum": [
            "none",
            "gzip",
            "zstd"
          ]
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "segment_schema_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*\\.v[1-9][0-9]*$"
          }
        },
        "uri": {
          "type": "string",
          "pattern": "^(?:https?|s3|file)://.+$"
        },
        "inline_base64": {
          "type": "string",
          "minLength": 4,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "oneOf": [
        {
          "required": [
            "uri"
          ]
        },
        {
          "required": [
            "inline_base64"
          ]
        }
      ]
    }
  }
}
