{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.runtime.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "available_capabilities",
    "bar_update_mode"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.runtime.v2"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "available_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bar_update_mode": {
      "type": "string",
      "minLength": 1
    },
    "mtf_provider_port": {
      "type": [
        "string",
        "null"
      ]
    },
    "deterministic_clock": {
      "type": "boolean"
    },
    "deterministic_rng": {
      "type": "boolean"
    },
    "intent_sink": {
      "type": "string"
    },
    "visual_sink": {
      "type": [
        "string",
        "null"
      ]
    },
    "resource_limits": {
      "type": "object"
    },
    "fills_api_present": {
      "const": false
    }
  }
}
