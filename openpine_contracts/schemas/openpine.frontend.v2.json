{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.frontend.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "declarations",
    "inputs",
    "support_profile_ref"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.frontend.v2"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "declarations": {
      "type": "object"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "strategy_settings": {
      "type": "object"
    },
    "referenced_builtins": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "request_usage": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "static_resource_budgets": {
      "type": "object"
    },
    "support_profile_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semantic_profile": {
      "enum": [
        "legacy_4x",
        "strict_5x"
      ]
    }
  }
}
