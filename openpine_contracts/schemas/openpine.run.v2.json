{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.run.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "run_id",
    "kind",
    "state",
    "semantic_profile",
    "warmup_policy"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.run.v2"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "COMPILE",
        "BACKTEST",
        "OPTIMIZE",
        "PARITY",
        "PAPER",
        "LIVE",
        "BACKFILL"
      ]
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ast_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "data_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semantic_profile": {
      "enum": [
        "legacy_4x",
        "strict_5x"
      ]
    },
    "numeric_policy": {
      "type": "string"
    },
    "fill_policy": {
      "type": "string"
    },
    "warmup_policy": {
      "enum": [
        "CALC_ONLY",
        "TRADE_THROUGH_UNSCORED",
        "CALC_THEN_RESET_BROKER"
      ]
    },
    "score_window": {
      "type": "object"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "completed_at_utc_ms": {
      "type": [
        "integer",
        "null"
      ]
    }
  }
}
