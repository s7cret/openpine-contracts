{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.run.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "run_id",
    "run_mode",
    "state",
    "stack_manifest_hash",
    "wheel_identities",
    "schema_hashes",
    "generated_artifact_hash",
    "data_snapshot_hash",
    "semantic_profile",
    "finality_policy",
    "warmup_policy",
    "score_policy",
    "required_capabilities"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.run.v2"
    },
    "schema_version": {
      "const": "2.1.0"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "run_mode": {
      "enum": [
        "COMPILE",
        "BACKTEST",
        "OPTIMIZE",
        "PARITY",
        "PAPER",
        "LIVE",
        "BACKFILL"
      ]
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "stack_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "wheel_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/WheelIdentity"
      }
    },
    "schema_hashes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ast_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "generated_artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "config_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "data_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "semantic_profile": {
      "enum": [
        "legacy_4x",
        "strict_5x"
      ]
    },
    "finality_policy": {
      "enum": [
        "CLOSED_BAR_ONLY",
        "ALLOW_OPEN"
      ]
    },
    "numeric_policy": {
      "type": "string"
    },
    "fill_policy": {
      "type": "string"
    },
    "warmup_policy": {
      "enum": [
        "CALC_ONLY",
        "TRADE_THROUGH_UNSCORED",
        "CALC_THEN_RESET_BROKER"
      ]
    },
    "score_policy": {
      "type": "string",
      "minLength": 1
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "broker_adapter_ref": {
      "type": "string",
      "minLength": 1
    },
    "broker_account_ref": {
      "type": "string",
      "minLength": 1
    },
    "score_window": {
      "type": "object"
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "input_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "output_artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "completed_at_utc_ms": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "$defs": {
    "WheelIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "content_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "run_mode": {
            "enum": [
              "PAPER",
              "LIVE"
            ]
          }
        },
        "required": [
          "run_mode"
        ]
      },
      "then": {
        "required": [
          "broker_adapter_ref",
          "broker_account_ref"
        ]
      }
    }
  ]
}
