{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.generated_artifact.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "source_hash",
    "frontend_artifact_hash",
    "ast_hash",
    "emitted_module_hash",
    "source_map_hash",
    "support_profile_hash",
    "lowering_version",
    "producer_commits",
    "semantic_profile",
    "required_runtime_capabilities",
    "import_allowlist",
    "entrypoint_module",
    "entrypoint_class"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.generated_artifact.v2"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "frontend_artifact_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ast_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "emitted_module_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_map_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "support_profile_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lowering_version": {
      "type": "string",
      "minLength": 1
    },
    "producer_commits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pine2ast",
        "ast2python",
        "pinelib",
        "openpine-contracts"
      ],
      "properties": {
        "pine2ast": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ast2python": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pinelib": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "openpine-contracts": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "semantic_profile": {
      "enum": [
        "legacy_4x",
        "strict_5x"
      ]
    },
    "numeric_policy": {
      "type": "string"
    },
    "required_runtime_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "import_allowlist": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
      }
    },
    "entrypoint_module": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "entrypoint_class": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "resource_estimate": {
      "type": "object"
    },
    "signature_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
