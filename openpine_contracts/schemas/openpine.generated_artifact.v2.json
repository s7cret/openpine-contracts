{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.generated_artifact.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "source_hash",
    "ast_hash",
    "emitted_module_hash",
    "source_map_hash",
    "lowering_version",
    "semantic_profile",
    "required_runtime_capabilities",
    "import_allowlist"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.generated_artifact.v2"
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "minLength": 1
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ast_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "emitted_module_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "source_map_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "lowering_version": {
      "type": "string",
      "minLength": 1
    },
    "semantic_profile": {
      "enum": [
        "legacy_4x",
        "strict_5x"
      ]
    },
    "numeric_policy": {
      "type": "string"
    },
    "required_runtime_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "import_allowlist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resource_estimate": {
      "type": "object"
    },
    "support_profile_ref": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "signature_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
