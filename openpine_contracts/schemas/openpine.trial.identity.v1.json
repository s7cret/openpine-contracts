{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.trial.identity.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "optimizer_id",
    "strategy_id",
    "generated_artifact_hash",
    "source_hash",
    "emitted_module_hash",
    "data_snapshot_hash",
    "stack_manifest_hash",
    "runner_fingerprint",
    "parameters",
    "policies",
    "schema_set",
    "seed",
    "fold",
    "walk_forward",
    "objective",
    "constraints"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.trial.identity.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "stack_id": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "optimizer_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_artifact_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "source_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "emitted_module_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "data_snapshot_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "stack_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "runner_fingerprint": {
      "type": "string",
      "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonNoFloat"
      }
    },
    "policies": {
      "$ref": "#/$defs/Policies"
    },
    "schema_set": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/SchemaIdentity"
      }
    },
    "seed": {
      "type": [
        "integer",
        "null"
      ]
    },
    "fold": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/FoldIdentity"
        }
      ]
    },
    "walk_forward": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/WalkForwardIdentity"
        }
      ]
    },
    "objective": {
      "$ref": "#/$defs/ObjectiveIdentity"
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ConstraintIdentity"
      }
    }
  },
  "$defs": {
    "JsonNoFloat": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonNoFloat"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonNoFloat"
          }
        }
      ]
    },
    "Policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semantic_profile",
        "finality_policy",
        "warmup_policy",
        "score_policy",
        "end_policy",
        "numeric_policy",
        "fill_policy"
      ],
      "properties": {
        "semantic_profile": {
          "enum": [
            "legacy_4x",
            "strict_5x"
          ]
        },
        "finality_policy": {
          "enum": [
            "CLOSED_BAR_ONLY",
            "ALLOW_OPEN"
          ]
        },
        "warmup_policy": {
          "enum": [
            "CALC_ONLY",
            "TRADE_THROUGH_UNSCORED",
            "CALC_THEN_RESET_BROKER"
          ]
        },
        "score_policy": {
          "enum": [
            "ALL_BARS",
            "AFTER_WARMUP"
          ]
        },
        "end_policy": {
          "enum": [
            "LIQUIDATE_ON_LAST_BAR",
            "PRESERVE_OPEN_POSITIONS"
          ]
        },
        "numeric_policy": {
          "type": "string",
          "minLength": 1
        },
        "fill_policy": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "SchemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_hash"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "minLength": 1
        },
        "schema_hash": {
          "type": "string",
          "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$"
        }
      }
    },
    "FoldIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fold_id",
        "train_start_utc_ms",
        "train_end_utc_ms",
        "test_start_utc_ms",
        "test_end_utc_ms"
      ],
      "properties": {
        "fold_id": {
          "type": "string",
          "minLength": 1
        },
        "train_start_utc_ms": {
          "type": "integer",
          "minimum": 0
        },
        "train_end_utc_ms": {
          "type": "integer",
          "minimum": 0
        },
        "test_start_utc_ms": {
          "type": "integer",
          "minimum": 0
        },
        "test_end_utc_ms": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "WalkForwardIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "window_size",
        "step_size",
        "anchored"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "window_size": {
          "type": "integer",
          "minimum": 1
        },
        "step_size": {
          "type": "integer",
          "minimum": 1
        },
        "anchored": {
          "type": "boolean"
        }
      }
    },
    "ObjectiveIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "direction",
        "aggregation"
      ],
      "properties": {
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "MINIMIZE",
            "MAXIMIZE"
          ]
        },
        "aggregation": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ConstraintIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "operator",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        }
      }
    }
  }
}
