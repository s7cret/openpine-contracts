{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.event.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "event_id",
    "event_type",
    "sequence",
    "occurred_at_utc_ms",
    "observed_at_utc_ms",
    "payload_hash",
    "payload"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.event.v1"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "occurred_at_utc_ms": {
      "type": "integer"
    },
    "observed_at_utc_ms": {
      "type": "integer"
    },
    "phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "payload": {
      "$ref": "#/$defs/JsonObjectNoFloat"
    }
  },
  "$defs": {
    "JsonNoFloat": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JsonNoFloat"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/JsonNoFloat"
          }
        }
      ]
    },
    "JsonObjectNoFloat": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/JsonNoFloat"
      }
    }
  }
}
