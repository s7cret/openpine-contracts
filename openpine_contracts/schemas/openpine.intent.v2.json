{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openpine.intent.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_id",
    "schema_version",
    "producer",
    "producer_version",
    "producer_commit",
    "stack_id",
    "created_at_utc_ms",
    "serializer_id",
    "content_hash_alg",
    "content_hash",
    "event_id",
    "sequence",
    "command_id",
    "kind",
    "run_id",
    "strategy_id",
    "series_id",
    "instrument_id",
    "timeframe",
    "bar_index",
    "bar_open_time_utc_ms",
    "phase",
    "recalc_iteration",
    "semantic_profile",
    "source_span",
    "idempotency_key"
  ],
  "properties": {
    "schema_id": {
      "const": "openpine.intent.v2"
    },
    "schema_version": {
      "const": "2.1.0"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "producer_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "producer_commit": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "serializer_id": {
      "const": "openpine.canonical.json.v1"
    },
    "content_hash_alg": {
      "const": "sha256"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "entry",
        "order",
        "exit",
        "close",
        "close_all",
        "cancel",
        "cancel_all",
        "risk"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "strategy_id": {
      "type": "string",
      "minLength": 1
    },
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "instrument_id": {
      "type": "string",
      "minLength": 1
    },
    "timeframe": {
      "type": "string",
      "minLength": 1
    },
    "bar_index": {
      "type": "integer",
      "minimum": 0
    },
    "bar_open_time_utc_ms": {
      "type": "integer",
      "minimum": 0
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "recalc_iteration": {
      "type": "integer",
      "minimum": 0
    },
    "source_span": {
      "$ref": "#/$defs/SourceSpan"
    },
    "semantic_profile": {
      "enum": [
        "legacy_4x",
        "strict_5x"
      ]
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "origin_command_kind": {
      "type": "string"
    },
    "order_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "enum": [
        "LONG",
        "SHORT",
        "long",
        "short"
      ]
    },
    "qty": {
      "type": "string",
      "minLength": 1,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "qty_percent": {
      "type": "string",
      "minLength": 1,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "price": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "limit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "profit": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "loss": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trail_price": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trail_points": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "trail_offset": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "from_entry": {
      "type": "string",
      "minLength": 1
    },
    "oca_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "oca_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "comment": {
      "type": [
        "string",
        "null"
      ]
    },
    "immediately": {
      "type": "boolean"
    },
    "risk_rule": {
      "type": "string",
      "minLength": 1
    },
    "risk_value": {
      "type": "string",
      "minLength": 1,
      "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"
    },
    "risk_unit": {
      "type": "string",
      "minLength": 1
    },
    "risk_scope": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "SourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_offset",
        "end_offset",
        "start_line",
        "start_col",
        "end_line",
        "end_col"
      ],
      "properties": {
        "start_offset": {
          "type": "integer",
          "minimum": 0
        },
        "end_offset": {
          "type": "integer",
          "minimum": 0
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "start_col": {
          "type": "integer",
          "minimum": 0
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_col": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "entry"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "order_id",
          "direction",
          "qty"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "order"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "order_id",
          "direction",
          "qty"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "exit"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "order_id",
          "from_entry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "close"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "from_entry"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "close_all"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cancel"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "order_id"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "cancel_all"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": []
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "risk"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "risk_rule",
          "risk_value",
          "risk_unit",
          "risk_scope"
        ]
      }
    }
  ]
}
