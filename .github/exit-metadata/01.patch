+def with_exit_execution_metadata(payload: dict) -> dict:
+    """2.6 adds leg-specific text without reinterpreting earlier price policies.
+
+    exit_semantics_version explicitly selects the existing 2.2--2.5 constraints.
+    The new wrapper reuses those exact constraints instead of copying a second
+    price/target validation implementation. Old readers reject 2.6 on purpose.
+    """
+    from copy import deepcopy
+
+    legacy = deepcopy(payload["$defs"]["ExitIntent"])
+    metadata = {
+        "type": "object", "additionalProperties": False, "minProperties": 1,
+        "properties": {name: {"type": "string"} for name in (
+            "comment_profit", "comment_loss", "comment_trailing",
+            "alert_profit", "alert_loss", "alert_trailing",
+        )},
+    }
+
+    def rebind(value):
+        if isinstance(value, dict):
+            return {("exit_semantics_version" if key == "schema_version" else key): rebind(item)
+                    for key, item in value.items()}
+        if isinstance(value, list):
+            return ["exit_semantics_version" if item == "schema_version" else rebind(item)
+                    for item in value]
+        return value
+
+    extended = rebind(legacy)
+    extended["required"] += ["schema_version", "exit_metadata"]
+    extended["properties"].update(
+        schema_version={"const": "2.6.0"}, exit_metadata=metadata,
+    )
+    payload["$defs"]["ExitIntent"] = {"oneOf": [legacy, extended]}
+    payload["properties"]["schema_version"] = {
+        "enum": ["2.2.0", "2.3.0", "2.4.0", "2.5.0", "2.6.0"]
+    }
+    payload["properties"]["exit_semantics_version"] = {"enum": ["2.2.0", "2.3.0", "2.4.0", "2.5.0"]}
+    payload["properties"]["exit_metadata"] = metadata
+    return payload
+
