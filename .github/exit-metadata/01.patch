diff --git a/tests/test_exit_execution_metadata.py b/tests/test_exit_execution_metadata.py
new file mode 100644
index 0000000000000000000000000000000000000000..10157e5a518da051a0312858aef869e1ea7992cd
--- /dev/null
+++ b/tests/test_exit_execution_metadata.py
@@ -0,0 +1,116 @@
+"""Leg metadata preserves the exact older price/scope validation contract."""
+
+from copy import deepcopy
+
+import pytest
+from test_rc3_contracts import _intent
+
+from openpine_contracts import (
+    SchemaValidationError,
+    seal_content_hash,
+    validate_payload,
+    verify_content_hash,
+)
+
+FIELDS = (
+    "comment_profit",
+    "comment_loss",
+    "comment_trailing",
+    "alert_profit",
+    "alert_loss",
+    "alert_trailing",
+)
+
+
+def old(version):
+    kwargs = dict(order_id="X", schema_version=version)
+    if version == "2.3.0":
+        kwargs.update(exit_scope="all_entries", limit="110")
+    else:
+        kwargs["from_entry"] = "A"
+    if version in ("2.2.0", "2.4.0"):
+        kwargs.update(profit="2", limit="110")
+    if version in ("2.4.0", "2.5.0"):
+        kwargs["price_pair_policy"] = "first_trigger"
+    if version == "2.5.0":
+        kwargs.update(trail_points="5", trail_offset="2")
+    return _intent("exit", **kwargs)
+
+
+def extended(version="2.2.0", **metadata):
+    event = old(version)
+    event.update(
+        schema_version="2.6.0",
+        exit_semantics_version=version,
+        exit_metadata=metadata or {"comment_profit": "TP"},
+    )
+    return event
+
+
+@pytest.mark.parametrize("version", ["2.2.0", "2.3.0", "2.4.0", "2.5.0"])
+@pytest.mark.parametrize("field", FIELDS)
+@pytest.mark.parametrize("text", ["", "Тест <&> {{strategy.order.id}}"])
+def test_leg_text_roundtrips_without_changing_price_contract(version, field, text):
+    validate_payload("openpine.intent.v2", old(version))
+    event = seal_content_hash(extended(version, **{field: text}), schema_id="openpine.intent.v2")
+    validate_payload("openpine.intent.v2", event)
+    assert verify_content_hash(event, schema_id="openpine.intent.v2")
+    assert event["exit_metadata"][field] == text
+
+
+@pytest.mark.parametrize(
+    "fault",
+    [
+        "no_metadata",
+        "empty_metadata",
+        "null",
+        "bool",
+        "unknown_field",
+        "wrong_kind",
+        "old_version",
+        "unknown_base",
+        "missing_base",
+        "both_scopes",
+        "bad_pair",
+        "bad_trail",
+    ],
+)
+def test_ambiguous_or_malformed_metadata_cannot_bypass_old_contracts(fault):
+    event = extended()
+    if fault == "no_metadata":
+        event.pop("exit_metadata")
+    elif fault == "empty_metadata":
+        event["exit_metadata"] = {}
+    elif fault in {"null", "bool"}:
+        event["exit_metadata"]["comment_profit"] = None if fault == "null" else True
+    elif fault == "unknown_field":
+        event["exit_metadata"]["arbitrary"] = "x"
+    elif fault == "wrong_kind":
+        event["kind"] = "entry"
+        event.update(qty="1", direction="LONG")
+    elif fault == "old_version":
+        event["schema_version"] = "2.2.0"
+    elif fault == "unknown_base":
+        event["exit_semantics_version"] = "2.6.0"
+    elif fault == "missing_base":
+        event.pop("exit_semantics_version")
+    elif fault == "both_scopes":
+        event["exit_scope"] = "all_entries"
+    elif fault == "bad_pair":
+        event = extended("2.4.0")
+        event.pop("limit")
+    else:
+        event = extended("2.5.0")
+        event.pop("trail_offset")
+    with pytest.raises(SchemaValidationError):
+        validate_payload("openpine.intent.v2", event)
+
+
+@pytest.mark.parametrize("version", ["2.2.0", "2.3.0", "2.4.0", "2.5.0"])
+def test_metadata_is_not_an_unversioned_addition(version):
+    event = old(version)
+    before = deepcopy(event)
+    event["exit_metadata"] = {"alert_profit": "TP"}
+    with pytest.raises(SchemaValidationError):
+        validate_payload("openpine.intent.v2", event)
+    validate_payload("openpine.intent.v2", before)
